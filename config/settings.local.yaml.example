# Copy to config/settings.local.yaml. Gitignored, and merged over
# settings.yaml at load time, so keep only the keys you actually change.
#
#   cp config/settings.local.yaml.example config/settings.local.yaml
#
# The committed settings.yaml stays on mock providers so a fresh checkout runs
# without spending anything. Real providers belong here, where `git pull` will
# not fight them.
#
# Nested keys merge; lists replace. `shorts doctor` prints which override files
# are in effect, and `shorts config` prints the merged result.

# Everything on one Gemini key. Put that key in .env under all five names:
# LLM_API_KEY, SEARCH_API_KEY, IMAGE_API_KEY, VIDEO_API_KEY, TTS_API_KEY.
# They are separate so one can be rotated, or pointed at another vendor,
# without touching the others.
providers:
  llm: gemini
  search: gemini
  image: gemini
  video: veo
  tts: gemini

# Run `python scripts/list_gemini_models.py` first and use ids from its output.
# A model missing from that list is not available to your key, whatever the
# documentation says.

llm:
  model: gemini-2.5-flash

search:
  # A 3.x model grounds at roughly 2.5x lower cost with a larger free tier.
  model: gemini-2.5-flash

image:
  model: imagen-4.0-generate-001

video:
  model: veo-3.1-fast-generate-preview
  # Veo returns fixed clip lengths. A request rounds UP to the shortest one
  # that covers it, so this also decides what you are billed.
  allowed_durations: [4, 6, 8]
  # A real Veo job takes minutes; 2s polling just burns requests.
  poll_interval_sec: 15

tts:
  model: gemini-2.5-flash-preview-tts
  # `python scripts/list_gemini_models.py --kind tts` for what is available.
  voice: Kore
  # Gemini takes delivery direction in the prompt rather than as parameters.
  # Keep this in step with config/voice.yaml's tone profile.
  style_instruction: >
    차분하고 호기심 있는 다큐멘터리 내레이터로, 친구에게 흥미로운 것을
    설명하듯 읽어주세요. 과장하지 말고, 문장 사이는 자연스럽게 쉬어주세요.

# OpenAI is still wired for llm and tts if you would rather use it; set
# providers.llm/tts to "openai" and put OPENAI_API_KEY and TTS_API_KEY in .env.
