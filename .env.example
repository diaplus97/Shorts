# Secrets only. All non-secret configuration lives in config/settings.yaml.
# Copy to .env and fill in the providers you actually use.

# LLM (research / writer / director)
OPENAI_API_KEY=

# Web search used by the research stage
SEARCH_API_KEY=

# Still-image provider (fallback assets)
IMAGE_API_KEY=

# Video generation provider
VIDEO_API_KEY=

# Text-to-speech provider
TTS_API_KEY=

# Set to 1 ONLY when you intentionally run `pytest -m live` against paid APIs.
ALLOW_LIVE_API_TESTS=0
