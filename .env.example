# Secrets only. All non-secret configuration lives in config/settings.yaml.
# Copy to .env and fill in the providers you actually use.

# LLM (research / writer / director)
OPENAI_API_KEY=

# Search, images and video are all Gemini in the default configuration, so the
# same key goes in all three. They are kept separate so one can be rotated, or
# pointed at a different vendor, without touching the others.
#
#   SEARCH_API_KEY  research stage, via Google Search grounding
#   IMAGE_API_KEY   still images, via Imagen
#   VIDEO_API_KEY   clips, via Veo
#
# Run `python scripts/list_gemini_models.py` to see which models a key can use.
SEARCH_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=

# Text-to-speech provider
TTS_API_KEY=

# Set to 1 ONLY when you intentionally run `pytest -m live` against paid APIs.
ALLOW_LIVE_API_TESTS=0
